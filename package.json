{
  "name": "tekcroft",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "chrome >= 92",
    "firefox >= 92",
    "safari >= 15.4",
    "edge >= 92",
    "not dead",
    "not op_mini all"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/hash-assets.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "optimize:images": "node scripts/optimize-assets.mjs",
    "optimize:heroes": "node scripts/optimize-heroes.mjs",
    "optimize:services": "node scripts/slim-service-pages.mjs",
    "audit:perf": "node scripts/verify-perf.mjs && node scripts/live-audit.mjs",
    "verify:icons": "node scripts/verify-icons-live.mjs"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.25",
    "sharp": "^0.35.4",
    "typescript": "^5"
  }
}
